{
  "name": "signalstory-workspace",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint . --ext .ts",
    "check": "ng build signalstory && npx agadoo ./dist/signalstory/fesm2022/signalstory.mjs",
    "cz": "cz"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@eslint/js": "^9.0.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@types/node": "^24.0.0",
    "angular-eslint": "^22.0.0",
    "agadoo": "^3.0.0",
    "commitizen": "^4.3.0",
    "cz-git": "^1.8.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.1.0",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.1.0",
    "prettier-eslint": "^16.1.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.8"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{ts,json,html,tsx}": "prettier --write"
  }
}
